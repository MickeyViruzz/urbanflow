# UrbanFlow backend configuration
# Copy this file to backend/.env and adjust as needed.

# PostgreSQL. The bundled local dev database (scripts/start_db.sh) uses port 5433.
DATABASE_URL=postgresql+psycopg://urbanflow@localhost:5433/urbanflow

# Comma-separated origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Protects the manual data-refresh endpoint. Change this outside local demos.
# If it is empty, the admin refresh endpoint is disabled.
ADMIN_TOKEN=urbanflow-admin

# Seed the clearly-labelled demonstration dataset when the database is empty.
DEMO_AUTOSEED=true

# External services (no API keys required).
OSRM_BASE_URL=https://router.project-osrm.org
NOMINATIM_URL=https://nominatim.openstreetmap.org
HTTP_USER_AGENT=UrbanFlowAcademicProject/1.0 (student project; contact: urbanflow@example.edu)

# Optional override for the traffic-police notices source.
TRAFFIC_POLICE_URL=https://trafficpolice.maharashtra.gov.in/
